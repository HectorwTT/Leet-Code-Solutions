class Solution {

    public boolean canReach(int[] start, int[] target) {

        if (Arrays.equals(start, target))
            return true;

        int rows = 7;
        int cols = 7;

        int[][] moves = {
                {2, 1},
                {2, -1},
                {1, 2},
                {1, -2},
                {-1, 2},
                {-1, -2},
                {-2, 1},
                {-2, -1}
        };

        Queue<int[]> queue = new LinkedList<>();

        // row, col, parity (0 = even, 1 = odd)
        queue.offer(new int[]{start[0], start[1], 0});

        boolean[][][] visited = new boolean[8][8][2];
        visited[start[0]][start[1]][0] = true;

        while (!queue.isEmpty()) {

            int[] curr = queue.poll();

            int row = curr[0];
            int col = curr[1];
            int parity = curr[2];

            for (int[] move : moves) {

                int newRow = row + move[0];
                int newCol = col + move[1];

                if (newRow < 0 || newRow > rows ||
                        newCol < 0 || newCol > cols)
                    continue;

                int newParity = 1 - parity;

                if (newRow == target[0]
                        && newCol == target[1]
                        && newParity == 0)
                    return true;

                if (!visited[newRow][newCol][newParity]) {

                    visited[newRow][newCol][newParity] = true;

                    queue.offer(new int[]{
                            newRow,
                            newCol,
                            newParity
                    });
                }
            }
        }

        return false;
    }
}
