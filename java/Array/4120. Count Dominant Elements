class Solution {
    public int countDominantElements(int[] nums) {
     if(nums.length==1)return 1;
     int answer=0;
     if(nums[0]>=nums[1])answer++;
     if(nums[nums.length-1]>=nums[nums.length-2])answer++;
     for(int i= 1;i<nums.length-1;i++){
      double curr=nums[i];
      double total=nums[i-1]+nums[i+1];
      double  average=total/2;
      if(curr>=average)answer++;
     } 
     return answer;  
    }
}
