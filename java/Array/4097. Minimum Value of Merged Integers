class Solution {
    public int minMergedInteger(int[] nums) {
     int answer=10001001;
     for(int i=0;i<nums.length;i+=2){
      int curr=nums[i];
      int next=nums[i+1];
      int number=Integer.parseInt(curr+""+next);
      answer=Math.min(answer,number);  
     } 
     return answer;  
    }
}
