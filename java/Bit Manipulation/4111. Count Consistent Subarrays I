class Solution {
    public int countConsistent(int[] nums) {
     int answer=0;
     for(int i=0;i<nums.length;i++){
      int min=nums[i]; 
      int bit=nums[i];
      if(bit==min)answer++;
      for(int j=i+1;j<nums.length;j++){
       min=Math.min(nums[j],min);
       bit&= nums[j];
       if(bit==min)answer++;
      }      
     } 
     return answer;    
    }
}
