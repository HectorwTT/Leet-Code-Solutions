class Solution {
    public int countValidPrefixes(String s) {
      int answer=1;
      int numberOfZeroes=0;
      int numberOfOnes=0;
      if(s.charAt(0)=='0') numberOfZeroes++;
      else numberOfOnes++;  
      for(int i=1;i<s.length();i++){
       char bit=s.charAt(i);
       if(bit=='0')numberOfZeroes++;
       else numberOfOnes++;
       if(i%2==1){
         if(numberOfOnes==numberOfZeroes)answer++;
       } else{
        if(numberOfOnes -numberOfZeroes==1 || numberOfZeroes-numberOfOnes==1)answer++;
       }   
      }

      return answer; 
    }
}
