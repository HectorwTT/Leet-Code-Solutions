class Solution {
    public String rearrangeString(String s, char x, char y) {
      String answer="";
      int numberOfX=0;
      int numberOfY=0;
      for(int i=0;i<s.length();i++){
       char ch=s.charAt(i);
       if(ch==x)numberOfX++ ;
       else if(ch==y)numberOfY++;
       else answer+=ch;
      }
      String xString=""+x;
      String yString=""+y;
      answer+=yString.repeat(numberOfY);
      answer+=xString.repeat(numberOfX);
      return answer;
    }
}
