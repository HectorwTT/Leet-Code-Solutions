class Solution {
    public long gcdSum(int[] nums) {
       int [] prefixGcd=new int[nums.length];
       int max=0;
       long answer=0;
       int left=0;
       int right=nums.length-1;
       for(int i=0;i<nums.length;i++){
        max=Math.max(nums[i],max); 
        prefixGcd[i]=gcd(max,nums[i]);
       }
       Arrays.sort(prefixGcd);
       while(left<right){
        int number=gcd(prefixGcd[left++],prefixGcd[right--]);
        answer+=1L*number;
       }
       return answer;
    }

    int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

}
