class Solution {

    List<String> result = new ArrayList<>();

    public List<String> readBinaryWatch(int turnedOn) {
        backtrack(0, 0, 0, turnedOn);
        return result;
    }

    private void backtrack(int index, int hour, int minute, int turnedOn) {

        // Too many LEDs turned on
        if (turnedOn < 0) {
            return;
        }

        // All 10 LEDs processed
        if (index == 10) {

            if (hour < 12 && minute < 60 && turnedOn == 0) {
                result.add(String.format("%d:%02d", hour, minute));
            }

            return;
        }

        // Don't turn this LED on
        backtrack(index + 1, hour, minute, turnedOn);

        // Turn this LED on
        if (index < 4) {
            // Hour LED
            backtrack(
                index + 1,
                hour + (1 << index),
                minute,
                turnedOn - 1
            );
        } else {
            // Minute LED
            backtrack(
                index + 1,
                hour,
                minute + (1 << (index - 4)),
                turnedOn - 1
            );
        }
    }
}
