public class Solution {
    public int PeakValleyDifference(int[] nums) {
      int  sumOfPeaks=0;   
      int sumOfValleys=0;
      for(int i=1;i<nums.Length-1;i++){
       if(nums[i]>nums[i-1] && nums[i]>nums[i+1]) sumOfPeaks+=nums[i];
       if(nums[i]<nums[i-1] && nums[i]<nums[i+1]) sumOfValleys+=nums[i];
      }
      return sumOfPeaks-sumOfValleys;   
    }
}
