public class Solution {
    public string[] AssignUmbrella(int[] rain) {
      string [] answer=new string[rain.Length];
      int countAlice=0;
      int countBob=0;
      for(int i=0;i<rain.Length-1;i++){
       if(rain[i]==0)answer[i]="None";
       if(rain[i]==1){
        if(rain[i]!=rain[i+1]){
         answer[i]="Bob";
         countBob++;
        }else{
          if(countBob<countAlice){
            answer[i]="Bob";
            countBob++;
          }else{
            answer[i]="Alice";
            countAlice++;
          }
        }
       } 
      }
      if(rain[rain.Length-1]==0)answer[answer.Length-1]="None";
      else answer[answer.Length-1]="Bob";
      return answer;   
    }
}
